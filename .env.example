# ---------------------------------------------------------------------------
# Nexora OS — environment configuration
# Copy to .env.local (development) or configure in your host (production).
# This file contains PLACEHOLDERS ONLY. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Core ------------------------------------------------------------------
# Public origin of the app. Used for links in emails and for cookie security.
APP_URL=http://localhost:3000

# 32+ byte random string. Generate with:  openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# --- Database --------------------------------------------------------------
# PRODUCTION: a real PostgreSQL 14+ connection string.
#   postgresql://user:password@host:5432/nexora?schema=public&sslmode=require
# DEVELOPMENT: `npm run db:start` boots an embedded PostgreSQL (PGlite) that
# speaks the real Postgres wire protocol on port 5434.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres?schema=public

# --- Object storage --------------------------------------------------------
# STORAGE_DRIVER=local  -> files written to ./.storage (development only)
# STORAGE_DRIVER=s3     -> S3-compatible private bucket (production)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Max upload size in bytes (default 25 MiB)
UPLOAD_MAX_BYTES=26214400

# --- Email -----------------------------------------------------------------
# EMAIL_DRIVER=log  -> messages written to ./.mail and logged (development)
# EMAIL_DRIVER=smtp -> real delivery
EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Nexora OS <no-reply@example.com>"

# --- Scheduled jobs --------------------------------------------------------
# Shared secret required by /api/cron/*. Send as: Authorization: Bearer <secret>
CRON_SECRET=replace-me-with-a-long-random-cron-secret

# --- Bootstrap (first run only) --------------------------------------------
# Used by `npm run bootstrap:admin` to create the first Owner account.
# Must not collide with a demo seed account (those use example.com).
BOOTSTRAP_OWNER_EMAIL=owner@your-office.test
BOOTSTRAP_OWNER_NAME="Workspace Owner"
# If omitted, a strong password is generated and printed once.
BOOTSTRAP_OWNER_PASSWORD=

# --- Workspace defaults ----------------------------------------------------
WORKSPACE_NAME="Nexora Office"
WORKSPACE_BASE_CURRENCY=PKR
WORKSPACE_TIMEZONE=Asia/Karachi

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
