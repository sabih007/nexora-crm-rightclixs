// ---------------------------------------------------------------------------
// Nexora OS — data model
//
// Conventions
//  * UUID primary keys (`@db.Uuid`, generated by Postgres `gen_random_uuid()`).
//  * All monetary values are Postgres NUMERIC(18,4) mapped to Prisma Decimal.
//    JavaScript floating point is never used for money anywhere in this app.
//  * Every business table carries `workspaceId` and is always queried through
//    a workspace-scoped helper, even though v1 runs a single workspace.
//  * Deletes default to RESTRICT for financial records so history can never be
//    silently destroyed; CASCADE is used only for owned child rows.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  OWNER
  ADMIN
  FINANCE
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum TaxMode {
  /// Tax rate is applied per line item.
  PER_LINE
  /// A single tax rate applies to the whole invoice subtotal.
  INVOICE_LEVEL
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  ONLINE
  OTHER
}

enum CardStatus {
  ACTIVE
  EXPIRED
  BLOCKED
  CANCELLED
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  DISCOVER
  UNIONPAY
  JCB
  OTHER
}

enum LinkStatus {
  ACTIVE
  REMOVED
  UNKNOWN
}

enum Cadence {
  MONTHLY
  QUARTERLY
  ANNUAL
  WEEKLY
  CUSTOM_DAYS
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAUSED
  CANCELLED
  EXPIRED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  FAILED
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum NotificationType {
  RENEWAL_REMINDER
  INVOICE_OVERDUE
  TASK_ASSIGNED
  TASK_DUE
  PAYMENT_RECORDED
  SYSTEM
}

enum ReminderChannel {
  IN_APP
  EMAIL
}

enum ImportStatus {
  DRAFT
  VALIDATED
  COMMITTED
  FAILED
}

// ===========================================================================
// Workspace, identity & access
// ===========================================================================

model Workspace {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  baseCurrency  String   @default("PKR") @db.Char(3)
  timezone      String   @default("UTC")
  invoicePrefix String   @default("INV")
  /// Next sequential number used when generating an invoice number.
  invoiceNextNo Int      @default(1)
  logoFileId    String?  @db.Uuid
  addressLine1  String?
  addressLine2  String?
  city          String?
  postalCode    String?
  country       String?
  taxId         String?
  email         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships      Membership[]
  clients          Client[]
  projects         Project[]
  invoices         Invoice[]
  payments         Payment[]
  creditNotes      CreditNote[]
  files            FileAsset[]
  folders          Folder[]
  cards            PaymentCard[]
  platforms        Platform[]
  platformLinks    PlatformCardLink[]
  subscriptions    Subscription[]
  domains          Domain[]
  expenses         Expense[]
  reminderRules    ReminderRule[]
  notifications    Notification[]
  jobExecutions    JobExecution[]
  auditLogs        AuditLog[]
  settings         Setting[]
  importJobs       ImportJob[]
  idempotencyKeys  IdempotencyKey[]

  @@map("workspaces")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String     @unique
  /// argon2id hash. Null only for accounts that have not accepted an invite.
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  avatarColor  String     @default("#315CFD")
  timezone     String?
  locale       String     @default("en")
  themePref    String     @default("system")

  /// TOTP secret, encrypted at rest with AUTH_SECRET-derived key.
  mfaSecretEnc     String?
  mfaEnabled       Boolean   @default(false)
  mfaEnrolledAt    DateTime?
  /// Hashed single-use recovery codes (argon2id), JSON array of strings.
  mfaRecoveryCodes Json?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  passwordChangedAt DateTime?

  emailOptOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  sessions         Session[]
  ownedProjects    Project[]           @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  assignedTasks    Task[]              @relation("TaskAssignee")
  taskComments     TaskComment[]
  uploadedFiles    FileAsset[]
  createdPayments  Payment[]
  createdExpenses  Expense[]
  ownedCards       PaymentCard[]
  ownedPlatforms   Platform[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]

  @@index([status])
  @@map("users")
}

model Membership {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@map("memberships")
}

model Session {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  /// SHA-256 of the opaque session token. The raw token is never stored.
  tokenHash      String   @unique
  /// CSRF token bound to this session (double-submit cookie pattern).
  csrfTokenHash  String
  userAgent      String?
  ipHash         String?
  /// Set once the TOTP challenge for this session has been satisfied.
  mfaSatisfiedAt DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rate-limit buckets for login and other sensitive actions. Persisted so the
/// limit survives restarts and works across serverless instances.
model RateLimit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketKey String   @unique
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
  @@map("rate_limits")
}

// ===========================================================================
// Clients
// ===========================================================================

model Client {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String       @db.Uuid
  type            ClientType   @default(COMPANY)
  name            String
  /// Lower-cased, punctuation-stripped name used for duplicate detection.
  normalizedName  String
  email           String?
  phone           String?
  website         String?
  addressJson     Json?
  billingCurrency String       @default("PKR") @db.Char(3)
  taxId           String?
  status          ClientStatus @default(ACTIVE)
  tags            String[]     @default([])
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  archivedAt      DateTime?

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      ClientContact[]
  projects      Project[]
  invoices      Invoice[]
  payments      Payment[]
  files         FileAsset[]
  folders       Folder[]
  subscriptions Subscription[]
  domains          Domain[]
  expenses      Expense[]

  @@index([workspaceId, status])
  @@index([workspaceId, normalizedName])
  @@index([workspaceId, archivedAt])
  @@map("clients")
}

model ClientContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @db.Uuid
  name      String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ===========================================================================
// Projects & tasks
// ===========================================================================

model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String        @db.Uuid
  clientId     String?       @db.Uuid
  name         String
  code         String?
  description  String?
  ownerId      String?       @db.Uuid
  status       ProjectStatus @default(PLANNING)
  priority     Priority      @default(MEDIUM)
  budgetAmount Decimal?      @db.Decimal(18, 4)
  currency     String        @default("PKR") @db.Char(3)
  startDate    DateTime?     @db.Date
  dueDate      DateTime?     @db.Date
  completedAt  DateTime?
  tags         String[]      @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  owner         User?           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  tasks         Task[]
  invoices      Invoice[]
  files         FileAsset[]
  folders       Folder[]
  subscriptions Subscription[]
  expenses      Expense[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, dueDate])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @db.Uuid
  assigneeId  String?    @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?  @db.Date
  /// Fractional ordering index within the status column (Kanban).
  position    Decimal    @default(1000) @db.Decimal(18, 6)
  checklist   Json?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments TaskComment[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

// ===========================================================================
// Invoicing & payments
// ===========================================================================

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String        @db.Uuid
  clientId      String        @db.Uuid
  projectId     String?       @db.Uuid
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  currency      String        @db.Char(3)
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date

  taxMode        TaxMode @default(PER_LINE)
  /// Used when taxMode = INVOICE_LEVEL. Percentage, e.g. 17.0000 for 17%.
  invoiceTaxRate Decimal @default(0) @db.Decimal(9, 4)

  subtotal      Decimal @default(0) @db.Decimal(18, 4)
  discountTotal Decimal @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal @default(0) @db.Decimal(18, 4)
  grandTotal    Decimal @default(0) @db.Decimal(18, 4)
  amountPaid    Decimal @default(0) @db.Decimal(18, 4)
  creditedTotal Decimal @default(0) @db.Decimal(18, 4)

  /// Immutable copy of the client's billing details at issue time.
  clientSnapshotJson Json?
  /// Immutable copy of totals + lines captured when the invoice was issued.
  issuedSnapshotJson Json?

  terms String?
  notes String?

  issuedAt   DateTime?
  sentAt     DateTime?
  paidAt     DateTime?
  voidedAt   DateTime?
  voidReason String?
  cancelledAt DateTime?

  pdfFileId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  payments    Payment[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]
  reminders   InvoiceReminder[]

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, issueDate])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceLine {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String  @db.Uuid
  description    String
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  /// Percentage, e.g. 17.0000 for 17%. Ignored when taxMode = INVOICE_LEVEL.
  taxRate        Decimal @default(0) @db.Decimal(9, 4)
  lineSubtotal   Decimal @default(0) @db.Decimal(18, 4)
  lineTax        Decimal @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal @default(0) @db.Decimal(18, 4)
  position       Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @db.Uuid
  clientId    String        @db.Uuid
  amount      Decimal       @db.Decimal(18, 4)
  currency    String        @db.Char(3)
  paymentDate DateTime      @db.Date
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  receiptFileId String?     @db.Uuid
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   String?             @db.Uuid

  @@index([workspaceId, paymentDate])
  @@index([workspaceId, clientId])
  @@index([invoiceId])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @db.Uuid
  invoiceId       String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(18, 4)
  createdAt       DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model CreditNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  invoiceId   String   @db.Uuid
  number      String
  currency    String   @db.Char(3)
  amount      Decimal  @db.Decimal(18, 4)
  reason      String
  issuedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, number])
  @@index([invoiceId])
  @@map("credit_notes")
}

model InvoiceReminder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId  String   @db.Uuid
  /// Negative = before due date, positive = after.
  offsetDays Int
  sentAt     DateTime @default(now())
  channel    ReminderChannel
  /// Deduplication key: invoiceId:offsetDays
  dedupeKey  String   @unique

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_reminders")
}

// ===========================================================================
// Files & folders
// ===========================================================================

model Folder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  parentId    String?  @db.Uuid
  clientId    String?  @db.Uuid
  projectId   String?  @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Folder?          @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]         @relation("FolderTree")
  client    Client?          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files     FileFolderLink[]

  @@unique([workspaceId, parentId, name])
  @@index([workspaceId])
  @@map("folders")
}

model FileAsset {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String     @db.Uuid
  clientId     String?    @db.Uuid
  projectId    String?    @db.Uuid
  uploadedById String     @db.Uuid
  storageKey   String     @unique
  originalName String
  mimeType     String
  byteSize     Int
  checksum     String
  scanStatus   ScanStatus @default(PENDING)
  scanNote     String?
  version      Int        @default(1)
  /// Points at the first version of this file; null for v1 itself.
  rootFileId   String?    @db.Uuid
  category     String?
  tags         String[]   @default([])
  /// True for files that exist only as an internal artifact (invoice PDFs).
  isSystem     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  root       FileAsset?       @relation("FileVersions", fields: [rootFileId], references: [id], onDelete: Cascade)
  versions   FileAsset[]      @relation("FileVersions")
  folders    FileFolderLink[]
  importJobs ImportJob[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
  @@index([rootFileId])
  @@map("file_assets")
}

model FileFolderLink {
  fileId   String @db.Uuid
  folderId String @db.Uuid

  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([fileId, folderId])
  @@index([folderId])
  @@map("file_folder_links")
}

/// Spreadsheet import: a staged, previewable, confirm-before-commit job.
model ImportJob {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @db.Uuid
  fileId      String       @db.Uuid
  createdById String       @db.Uuid
  /// Which entity the rows will become, e.g. "clients".
  targetType  String
  status      ImportStatus @default(DRAFT)
  /// Detected header row.
  headersJson Json
  /// User-chosen header -> field mapping.
  mappingJson Json?
  /// Per-row validation errors discovered during the dry run.
  errorsJson  Json?
  totalRows   Int          @default(0)
  validRows   Int          @default(0)
  importedRows Int         @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file      FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("import_jobs")
}

// ===========================================================================
// Cards, platforms & subscriptions
//
// SECURITY: this module deliberately has NO column capable of holding a full
// card number, CVV, PIN or banking password. Only the last four digits and
// non-sensitive metadata are modelled.
// ===========================================================================

model PaymentCard {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String     @db.Uuid
  nickname    String
  issuer      String
  brand       CardBrand  @default(OTHER)
  /// Exactly four digits. Enforced by a CHECK constraint in the migration.
  last4       String     @db.Char(4)
  expiryMonth Int?
  expiryYear  Int?
  ownerId     String?    @db.Uuid
  status      CardStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  platformLinks PlatformCardLink[]
  subscriptions Subscription[]

  @@index([workspaceId, status])
  @@index([ownerId])
  @@map("payment_cards")
}

model Platform {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @db.Uuid
  name             String
  websiteUrl       String?
  category         String   @default("Other")
  /// Non-secret account identifier, e.g. the login email. Never a password.
  accountIdentifier String?
  cancellationUrl  String?
  ownerId          String?  @db.Uuid
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  cardLinks     PlatformCardLink[]
  subscriptions Subscription[]

  @@unique([workspaceId, name])
  @@index([workspaceId, category])
  @@map("platforms")
}

model PlatformCardLink {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String     @db.Uuid
  platformId     String     @db.Uuid
  cardId         String     @db.Uuid
  status         LinkStatus @default(ACTIVE)
  linkedAt       DateTime?
  removedAt      DateTime?
  lastVerifiedAt DateTime?
  responsibleId  String?    @db.Uuid
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform  Platform    @relation(fields: [platformId], references: [id], onDelete: Cascade)
  card      PaymentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platformId, cardId])
  @@index([cardId])
  @@index([platformId])
  @@map("platform_card_links")
}

model Subscription {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String  @db.Uuid
  platformId  String  @db.Uuid
  cardId      String? @db.Uuid
  projectId   String? @db.Uuid
  clientId    String? @db.Uuid

  planName String
  amount   Decimal @db.Decimal(18, 4)
  currency String  @db.Char(3)
  cadence  Cadence @default(MONTHLY)
  /// For CUSTOM_DAYS: the number of days between charges. Required then.
  intervalDays Int?

  nextChargeAt DateTime  @db.Date
  startedAt    DateTime  @db.Date
  endsAt       DateTime? @db.Date
  trialEndsAt  DateTime? @db.Date

  autoRenew  Boolean            @default(true)
  status     SubscriptionStatus @default(ACTIVE)
  category   String             @default("Software")
  costCenter String?
  noticeDays Int?
  taxInclusive Boolean          @default(true)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform  Platform     @relation(fields: [platformId], references: [id], onDelete: Restrict)
  card      PaymentCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  expenses  Expense[]
  reminders SubscriptionReminder[]

  @@index([workspaceId, status])
  @@index([workspaceId, nextChargeAt])
  @@index([cardId])
  @@index([platformId])
  @@map("subscriptions")
}

model SubscriptionReminder {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String          @db.Uuid
  daysBefore     Int
  /// The charge date this reminder was sent for (prevents resend per cycle).
  chargeDate     DateTime        @db.Date
  channel        ReminderChannel
  sentAt         DateTime        @default(now())
  /// subscriptionId:chargeDate:daysBefore:channel
  dedupeKey      String          @unique

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_reminders")
}

model Expense {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @db.Uuid
  subscriptionId String?  @db.Uuid
  projectId      String?  @db.Uuid
  clientId       String?  @db.Uuid
  amount         Decimal  @db.Decimal(18, 4)
  currency       String   @db.Char(3)
  paidAt         DateTime @db.Date
  category       String   @default("Software")
  description    String
  reference      String?
  receiptFileId  String?  @db.Uuid
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, paidAt])
  @@index([workspaceId, category])
  @@index([subscriptionId])
  @@map("expenses")
}

// ===========================================================================
// Platform services: rates, reminders, notifications, jobs, audit, settings
// ===========================================================================

model ExchangeRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  /// 1 baseCurrency = `rate` quoteCurrency, on `effectiveDate`.
  rate          Decimal  @db.Decimal(20, 10)
  effectiveDate DateTime @db.Date
  source        String   @default("manual")
  createdAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, effectiveDate])
  @@index([baseCurrency, quoteCurrency, effectiveDate])
  @@map("exchange_rates")
}

model ReminderRule {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String          @db.Uuid
  entityType  String
  daysBefore  Int
  channel     ReminderChannel @default(IN_APP)
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, daysBefore, channel])
  @@map("reminder_rules")
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @db.Uuid
  userId      String           @db.Uuid
  type        NotificationType
  title       String
  body        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

model JobExecution {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String?   @db.Uuid
  jobKey      String
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  resultJson  Json?
  startedAt   DateTime?
  executedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([jobKey, createdAt])
  @@map("job_executions")
}

/// Generic idempotency guard for mutations that must never double-apply
/// (payment creation above all). Scoped per workspace + operation.
model IdempotencyKey {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  scope       String
  key         String
  /// Id of the entity produced by the first successful execution.
  resultId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  summary     String?
  beforeJson  Json?
  afterJson   Json?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  key         String
  valueJson   Json
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("settings")
}

// ===========================================================================
// Domains (synced from Spaceship)
// ===========================================================================

model Domain {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @db.Uuid
  clientId         String?   @db.Uuid
  name             String
  registrar        String    @default("Spaceship")
  registrationDate DateTime?
  /// Renewal happens on this date when autoRenew = true.
  expirationDate   DateTime?
  autoRenew        Boolean   @default(false)
  /// EPP statuses as returned by the registrar.
  status           String[]  @default([])
  notes            String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, expirationDate])
  @@index([clientId])
  @@map("domains")
}